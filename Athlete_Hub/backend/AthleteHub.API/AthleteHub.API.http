@AthleteHub.API_HostAddress = http://localhost:5007

GET {{AthleteHub.API_HostAddress}}/weatherforecast/
Accept: application/json


### Register Athlete
POST http://localhost:5007/api/Auth/register
Content-Type: application/json

{
    "universityId": "TEST-2026-001",
    "email": "testathlete@example.com",
    "password": "Password123!",
    "firstName": "Test",
    "middleName": "Athlete",
    "lastName": "User",
    "phone": "09123456789"
}


### Login Athlete
POST http://localhost:5007/api/Auth/login
Content-Type: application/json

{
    "email": "testathlete@example.com",
    "password": "Password123!"
}

### Get Current User
GET http://localhost:5007/api/Auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hy7_6mz9cD-e6RNQgkq01sZmyGte5BfE91RIgh4XW6c

### ATHLETE ROLE TEST
GET http://localhost:5007/api/RoleTest/athlete
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hy7_6mz9cD-e6RNQgkq01sZmyGte5BfE91RIgh4XW6c



### COACH ROLE TEST
GET http://localhost:5007/api/RoleTest/coach
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hy7_6mz9cD-e6RNQgkq01sZmyGte5BfE91RIgh4XW6c


### DIRECTOR ROLE TEST
GET http://localhost:5007/api/RoleTest/director
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hy7_6mz9cD-e6RNQgkq01sZmyGte5BfE91RIgh4XW6c

### Get My Athlete Profile
GET http://localhost:5007/api/AthleteProfile/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hy7_6mz9cD-e6RNQgkq01sZmyGte5BfE91RIgh4XW6c

### Update My Athlete Profile
PUT http://localhost:5007/api/AthleteProfile/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hy7_6mz9cD-e6RNQgkq01sZmyGte5BfE91RIgh4XW6c
Content-Type: application/json

{
    "course": "BS Information Technology",
    "yearLevel": 4,
    "birthDate": "2004-05-16",
    "profilePhotoUrl": "https://example.com/profile.jpg",
    "phone": "09123456789"
}

### Get My Academic Records
GET http://localhost:5007/api/AcademicRecords/me
Authorization: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..LEqeBE5m8N_rQkEEj5FLW-Y0wKOGTfZNB6NTFtmeXkY