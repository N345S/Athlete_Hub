############################################################
# REGISTER ATHLETE
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "universityId": "TEST-2026-001",
  "email": "testathlete@example.com",
  "password": "Password123!",
  "firstName": "Test",
  "middleName": "Athlete",
  "lastName": "User",
  "phone": "09123456789"
}


