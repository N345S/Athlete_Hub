@AthleteHub.API_HostAddress = http://localhost:5007

############################################################
# WEATHER FORECAST
############################################################

GET {{AthleteHub.API_HostAddress}}/weatherforecast/
Accept: application/json


############################################################
# DATABASE TEST
############################################################

GET {{AthleteHub.API_HostAddress}}/api/DatabaseTest
Accept: application/json


############################################################
# GET ROLES
############################################################

GET {{AthleteHub.API_HostAddress}}/api/Role
Accept: application/json


############################################################
# REGISTER ATHLETE
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "universityId": "TEST-2026-001",
  "email": "testathlete@example.com",
  "password": "Password123!",
  "firstName": "Test",
  "middleName": "Athlete",
  "lastName": "User",
  "phone": "09123456789"
}


############################################################
# LOGIN - ATHLETE
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testathlete@example.com",
  "password": "Password123!"
}
> {%
client.global.set("athleteToken", response.body.token);
%}




############################################################
# CREATE ACHIEVEMENT - ATHLETE
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Achievements
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3Yj85jWvXspRbKrCfkRLjW7g07cQAOv9ax9KvXHoVxY

{
  "title": "Regional Track and Field Champion",
  "description": "Placed first in the 100-meter sprint.",
  "achievementDate": "2026-08-01",
  "category": "SPORTS"
}


############################################################
# GET MY ACHIEVEMENTS - ATHLETE
############################################################

GET {{AthleteHub.API_HostAddress}}/api/Achievements/me
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3Yj85jWvXspRbKrCfkRLjW7g07cQAOv9ax9KvXHoVxY


############################################################
# CREATE PORTFOLIO ITEM - ATHLETE
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Portfolio
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3Yj85jWvXspRbKrCfkRLjW7g07cQAOv9ax9KvXHoVxY

{
  "title": "Regional Championship Portfolio Entry",
  "description": "A portfolio entry linked to an athletic achievement.",
  "displayOrder": 1,
  "isVisible": true
}


############################################################
# GET MY PORTFOLIO - ATHLETE
############################################################

GET {{AthleteHub.API_HostAddress}}/api/Portfolio/me
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3Yj85jWvXspRbKrCfkRLjW7g07cQAOv9ax9KvXHoVxY


############################################################
# UPLOAD DOCUMENT - ATHLETE
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Documents
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3Yj85jWvXspRbKrCfkRLjW7g07cQAOv9ax9KvXHoVxY
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="documentType"

TRANSCRIPT
--UploadBoundary
Content-Disposition: form-data; name="file"; filename="transcript.pdf"
Content-Type: application/pdf

< C:\Users\SMB\Documents\transcript.pdf
--UploadBoundary--


############################################################
# GET MY DOCUMENTS - ATHLETE
############################################################

GET {{AthleteHub.API_HostAddress}}/api/Documents/me
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3Yj85jWvXspRbKrCfkRLjW7g07cQAOv9ax9KvXHoVxY


