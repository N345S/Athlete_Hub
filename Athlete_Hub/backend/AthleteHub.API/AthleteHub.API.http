@AthleteHub.API_HostAddress = http://localhost:5007

############################################################
# SPRINT 1 - FOUNDATIONS AND AUTHENTICATION
############################################################

### Weather forecast
GET {{AthleteHub.API_HostAddress}}/weatherforecast/
Accept: application/json

### Database test
GET {{AthleteHub.API_HostAddress}}/api/DatabaseTest
Accept: application/json

### Get roles
GET {{AthleteHub.API_HostAddress}}/api/Role
Accept: application/json

### Register athlete
POST {{AthleteHub.API_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "universityId": "TEST-2026-001",
  "email": "testathlete@example.com",
  "password": "Password123!",
  "firstName": "Test",
  "middleName": "Athlete",
  "lastName": "User",
  "phone": "09123456789"
}

### Login athlete
POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testathlete@example.com",
  "password": "Password123!"
}

### Login coach
POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testcoach@athletehub.com",
  "password": "Coach123!"
}

### Login director
POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testdirector@athletehub.com",
  "password": "Director123!"
}


### Login admin
POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testadmin@athletehub.com",
  "password": "Admin123!"
}

### Login registrar
POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testregistrar@athletehub.com",
  "password": "Registrar123!"
}

############################################################
# SPRINT 2 - ATHLETE MANAGEMENT AND PORTFOLIO
############################################################

### Create achievement - athlete
POST {{AthleteHub.API_HostAddress}}/api/Achievements
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Ka7KQC23jhdIECx6MsTInxC2z5plU-3be7_EFKcv_MA

{
  "title": "Regional Track and Field Champion",
  "description": "Placed first in the 100-meter sprint.",
  "achievementDate": "2026-08-01",
  "category": "SPORTS"
}

### Get my achievements - athlete
GET {{AthleteHub.API_HostAddress}}/api/Achievements/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Ka7KQC23jhdIECx6MsTInxC2z5plU-3be7_EFKcv_MA

### Create portfolio item - athlete
POST {{AthleteHub.API_HostAddress}}/api/Portfolio
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Ka7KQC23jhdIECx6MsTInxC2z5plU-3be7_EFKcv_MA

{
  "title": "Regional Championship Portfolio Entry",
  "description": "A portfolio entry linked to an athletic achievement.",
  "displayOrder": 1,
  "isVisible": true
}

### Get my portfolio - athlete
GET {{AthleteHub.API_HostAddress}}/api/Portfolio/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Ka7KQC23jhdIECx6MsTInxC2z5plU-3be7_EFKcv_MA

### Get my documents - athlete
GET {{AthleteHub.API_HostAddress}}/api/Documents/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Ka7KQC23jhdIECx6MsTInxC2z5plU-3be7_EFKcv_MA

### Upload document - athlete
POST {{AthleteHub.API_HostAddress}}/api/Documents
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Ka7KQC23jhdIECx6MsTInxC2z5plU-3be7_EFKcv_MA
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="documentType"

TRANSCRIPT
--UploadBoundary
Content-Disposition: form-data; name="file"; filename="transcript.pdf"
Content-Type: application/pdf

< C:\Users\SMB\Documents\transcript.pdf
--UploadBoundary--

### Admin - get all users
GET {{AthleteHub.API_HostAddress}}/api/Admin/users
Authorization: Bearer {{adminToken}}

### Admin - get user
GET {{AthleteHub.API_HostAddress}}/api/Admin/users/6
Authorization: Bearer {{adminToken}}

### Admin - create coach account
POST {{AthleteHub.API_HostAddress}}/api/Admin/users
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "roleId": 2,
  "universityId": "TEST-COACH-CRUD-001",
  "email": "crudcoach@example.com",
  "password": "Coach123!",
  "firstName": "CRUD",
  "middleName": null,
  "lastName": "Coach",
  "phone": "09123456780"
}

### Admin - update user
PUT {{AthleteHub.API_HostAddress}}/api/Admin/users/6
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "phone": "09123456781",
  "accountStatus": "ACTIVE"
}

### Admin - delete user
DELETE {{AthleteHub.API_HostAddress}}/api/Admin/users/6
Authorization: Bearer {{adminToken}}

############################################################
# SPRINT 3 - ACADEMIC AND ATHLETIC MONITORING
############################################################

### Send grade evaluation - registrar
POST {{AthleteHub.API_HostAddress}}/api/GradeEvaluations
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..o2vIpyNOfadWCBn6YAb4Qbds4guI0ecqoZW_voqQEOw

{
  "athleteId": 1,
  "academicYear": "2026-2027",
  "semester": "FIRST",
  "records": [
    {
      "subjectCode": "PE101",
      "subjectName": "Athletic Performance",
      "units": 3,
      "grade": 92.5,
      "remarks": "Evaluation sent by registrar."
    }
  ]
}

### Academic records - athlete
GET {{AthleteHub.API_HostAddress}}/api/AcademicRecords/athlete/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..SY0_Su5YJuH5-kTo4_mBeYAYmvmtdxOi0S1C4-U09Vo

### Academic monitoring dashboard - athlete
GET {{AthleteHub.API_HostAddress}}/api/AcademicRecords/dashboard/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..SY0_Su5YJuH5-kTo4_mBeYAYmvmtdxOi0S1C4-U09Vo

### Delete academic record - registrar
DELETE {{AthleteHub.API_HostAddress}}/api/AcademicRecords/2
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..o2vIpyNOfadWCBn6YAb4Qbds4guI0ecqoZW_voqQEOw

### Coach monitoring dashboard
GET {{AthleteHub.API_HostAddress}}/api/CoachDashboard
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

### Performance metrics
GET {{AthleteHub.API_HostAddress}}/api/Performance/metrics
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

### Performance records for athlete
GET {{AthleteHub.API_HostAddress}}/api/Performance/athlete/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

### Create performance record - coach
POST {{AthleteHub.API_HostAddress}}/api/Performance/records
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

{
  "athleteId": 1,
  "metricId": 1,
  "recordedValue": 12.5,
  "recordedDate": "2026-09-02",
  "notes": "Sprint performance test"
}

### Training sessions
GET {{AthleteHub.API_HostAddress}}/api/Training/sessions
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

### Create training session - coach
POST {{AthleteHub.API_HostAddress}}/api/Training/sessions
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

{
  "teamId": 1,
  "title": "Morning Training",
  "description": "Sprint and conditioning",
  "trainingDate": "2026-09-03",
  "startTime": "08:00:00",
  "endTime": "10:00:00",
  "location": "Main Track"
}
### Delete Training session
DELETE {{AthleteHub.API_HostAddress}}/api/Training/sessions/2
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g


### Attendance for training session
GET {{AthleteHub.API_HostAddress}}/api/Training/sessions/1/attendance
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

### Mark attendance - coach
POST {{AthleteHub.API_HostAddress}}/api/Training/sessions/1/attendance
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..pvNGOGk0EXbSk2ZWCaurh9ZnSA0c_D-1Emznny5nA3g

{
  "athleteId": 1,
  "attendanceStatus": "PRESENT",
  "remarks": "Arrived on time"
}

### Eligibility records for athlete
GET {{AthleteHub.API_HostAddress}}/api/Eligibility/athlete/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..SY0_Su5YJuH5-kTo4_mBeYAYmvmtdxOi0S1C4-U09Vo

