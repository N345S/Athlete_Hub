############################################################
# LOGIN - REGISTRAR
############################################################

POST {{AthleteHub.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "testregistrar@athletehub.com",
  "password": "Registrar123!"
}
> {%
client.global.set("registrarToken", response.body.token);
%}


############################################################
# SEND GRADE EVALUATION - REGISTRAR
############################################################

POST {{AthleteHub.API_HostAddress}}/api/GradeEvaluations
Content-Type: application/json
Authorization: Bearer {{registrarToken}}

{
  "athleteId": 1,
  "academicYear": "2026-2027",
  "semester": "FIRST",
  "records": [
    {
      "subjectCode": "PE101",
      "subjectName": "Athletic Performance",
      "units": 3,
      "grade": 92.5,
      "remarks": "Evaluation sent by registrar."
    }
  ]
}


